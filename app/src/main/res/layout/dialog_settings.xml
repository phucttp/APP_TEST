<?xml version="1.0" encoding="utf-8"?>
<!-- Cài đặt: mỗi danh sách 1 dòng tóm tắt + nút SỬA (mở màn quản lý riêng) → hộp luôn gọn -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp">

        <!-- ===== DANH SÁCH ===== -->
        <TextView
            style="@style/TcSection"
            android:text="DANH SÁCH CHỌN" />

        <!-- Nhân viên test -->
        <LinearLayout
            android:id="@+id/rowStaff"
            style="@style/TcSettingRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvStaffTitle"
                    style="@style/TcRowTitle"
                    android:text="Nhân viên test" />
                <TextView
                    android:id="@+id/tvStaffSum"
                    style="@style/TcRowSummary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditStaff"
                style="@style/TcEditButton"
                android:text="SỬA ›" />
        </LinearLayout>

        <View style="@style/TcDivider" />

        <!-- Loại máy -->
        <LinearLayout
            android:id="@+id/rowType"
            style="@style/TcSettingRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvTypeTitle"
                    style="@style/TcRowTitle"
                    android:text="Loại máy" />
                <TextView
                    android:id="@+id/tvTypeSum"
                    style="@style/TcRowSummary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditType"
                style="@style/TcEditButton"
                android:text="SỬA ›" />
        </LinearLayout>

        <!-- ===== SHEET ===== -->
        <TextView
            style="@style/TcSection"
            android:layout_marginTop="18dp"
            android:text="SHEET GHI DỮ LIỆU" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAutoMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự tạo sheet theo tháng (vd. 11_2026)"
            android:textSize="14sp" />

        <!-- Chỉ dùng khi TẮT chế độ theo tháng -->
        <LinearLayout
            android:id="@+id/sheetManualBox"
            style="@style/TcSettingRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSheetTitle"
                    style="@style/TcRowTitle"
                    android:text="Danh sách sheet" />
                <TextView
                    android:id="@+id/tvSheetSum"
                    style="@style/TcRowSummary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSheet"
                style="@style/TcEditButton"
                android:text="SỬA ›" />
        </LinearLayout>

        <!-- ===== GOOGLE SHEET ===== -->
        <TextView
            style="@style/TcSection"
            android:layout_marginTop="18dp"
            android:text="KẾT NỐI GOOGLE SHEET" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Link bảng tính (docs.google.com/spreadsheets/...)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSheetLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Link Apps Script (script.google.com/.../exec)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScriptUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_blue"
                android:text="THỬ KẾT NỐI"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSheet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_black"
                android:text="MỞ SHEET"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/TcData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/tc_text_2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
