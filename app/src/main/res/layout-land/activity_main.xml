<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chính khi cầm NGANG: camera bên trái (rộng), thông tin + nút bên phải.
     Giữ đúng các id như bản dọc (layout/activity_main.xml) để dùng chung code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tc_black"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- ===== Camera ===== -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fitCenter" />

        <com.quaytest.app.SelectionOverlayView
            android:id="@+id/selection"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvTimer"
            style="@style/TcData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@color/tc_red"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@color/tc_overlay"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Kéo tay khoanh vùng MÃ THIẾT BỊ"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/tc_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="●\nBẮT ĐẦU"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="75dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="4dp" />

        <LinearLayout
            android:id="@+id/selPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManual"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_green"
                android:text="NHẬP MÃ TAY"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReuse"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_blue"
                android:text="DÙNG KHUNG CŨ"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_dark_gray"
                android:text="HUỶ"
                android:textSize="13sp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Mức zoom (chụm/banh 2 ngón để zoom, chạm nhãn để về 1x) -->
        <TextView
            android:id="@+id/tvZoom"
            style="@style/TcZoomPill"
            android:text="1.0x" />

        <TextView
            android:id="@+id/tvCountdown"
            style="@style/TcData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#000000"
            android:shadowRadius="12"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Vạch màu trạng thái (dọc) -->
    <View
        android:id="@+id/statusBar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/tc_blue" />

    <!-- ===== Bảng thông tin + nút bên phải ===== -->
    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="@color/tc_black"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="MÃ SẢN PHẨM"
            android:textColor="@color/tc_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCode"
            style="@style/TcData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="— chưa có —"
            android:textColor="@color/tc_text_muted"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPeople"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvClock"
            style="@style/TcData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tc_text_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfig"
            style="@style/TcButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="⚙ CÀI ĐẶT"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheet"
            style="@style/TcButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="LỊCH SỬ QUAY"
            android:textSize="13sp" />

        <!-- đẩy nút quay xuống đáy -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_amber"
                android:text="TẠM DỪNG"
                android:textColor="@color/tc_black"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/tc_dark_gray"
                android:text="■ DỪNG"
                android:textSize="15sp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
